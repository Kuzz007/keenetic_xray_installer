#!/bin/sh
set -e

GO_EXPERIMENTAL_TAG="${GO_EXPERIMENTAL_TAG:-0.1.3-go-experimental}"
GO_RESOLVER="/opt/bin/xray-failover-go"
XRAY_DIR="/opt/etc/xray"

mkdir -p /opt/bin /opt/libexec "$XRAY_DIR" /opt/var/log /opt/var/spool/cron/crontabs

detect_entware_arch() {
    if command -v opkg >/dev/null 2>&1; then
        opkg print-architecture 2>/dev/null | awk '
            $2 != "all" && ($3 + 0) >= max { arch = $2; max = $3 + 0 }
            END { if (arch != "") print arch }
        '
    fi
}

asset_name_for_arch() {
    ARCH="$1"
    case "$ARCH" in
        aarch64-3.10|aarch64*) echo "xray-failover-go-linux-arm64" ;;
        mipsel-3.4|mipsel*|mipselsf-k3.4|mipselsf*) echo "xray-failover-go-linux-mipsle" ;;
        *) echo "" ;;
    esac
}

ENTWARE_ARCH="${ENTWARE_ARCH:-$(detect_entware_arch)}"
[ -n "$ENTWARE_ARCH" ] || ENTWARE_ARCH="$(uname -m 2>/dev/null || echo unknown)"

GO_ASSET_NAME="${GO_ASSET_NAME:-$(asset_name_for_arch "$ENTWARE_ARCH")}"
[ -n "$GO_ASSET_NAME" ] || { echo "ERROR: unsupported architecture for Go resolver: $ENTWARE_ARCH" >&2; exit 1; }

GO_BINARY_URL="${GO_BINARY_URL:-https://github.com/Kuzz007/keenetic_xray_installer/releases/download/${GO_EXPERIMENTAL_TAG}/${GO_ASSET_NAME}}"

if [ ! -x "$GO_RESOLVER" ]; then
    echo "Detected architecture: $ENTWARE_ARCH"
    echo "Downloading Go resolver/generator: $GO_BINARY_URL"
    curl -fL -o "$GO_RESOLVER" "$GO_BINARY_URL"
    chmod +x "$GO_RESOLVER"
else
    echo "Existing Go resolver/generator found: $GO_RESOLVER"
fi

[ -s "$XRAY_DIR/vless-go.active" ] || printf '%s\n' primary > "$XRAY_DIR/vless-go.active"
[ -s "$XRAY_DIR/vless-go.primary.selector" ] || printf '%s\n' first > "$XRAY_DIR/vless-go.primary.selector"
[ -s "$XRAY_DIR/vless-go.backup.selector" ] || printf '%s\n' first > "$XRAY_DIR/vless-go.backup.selector"
chmod 600 "$XRAY_DIR"/vless-go.* 2>/dev/null || true

touch /opt/var/spool/cron/crontabs/root 2>/dev/null || true
chmod 600 /opt/var/spool/cron/crontabs/root 2>/dev/null || true

echo "failover-go package installed."
echo "Next steps:"
echo "  1. Run initial setup: xray_vless_failover_go.sh"
echo "  2. Open menu: failover-go"
echo "  3. Run diagnostics: vless-go-doctor"
exit 0
